#!/usr/bin/env bash
set -euo pipefail
tawc=$1
assets=$2
source_dir="$(cd "$(dirname "$0")/../graphics" && pwd)"
cd "$tawc"

bash scripts/ensure-deps.sh libhybris
patch_file="$source_dir/../upstream/libhybris-chromium-egl.patch"
if ! git -C deps/libhybris apply --reverse --check "$patch_file" 2>/dev/null; then
    git -C deps/libhybris apply "$patch_file"
fi

# Debian omits this private header from libwayland-dev. Use the Wayland
# sources already pinned and fetched by the Xwayland build.
export TAWC_LIBHYBRIS_CPPFLAGS="-idirafter $PWD/deps/xwayland-src/wayland/egl"
bash scripts/build-libhybris.sh
hybris="$PWD/build/libhybris-aarch64/install/usr/lib/hybris"
work="$PWD/build/libhybris-aarch64/probe"
mkdir -p "$work" "$assets"

protocol="$PWD/deps/xwayland-src/wayland-protocols/stable/xdg-shell/xdg-shell.xml"
wayland-scanner client-header "$protocol" "$work/xdg-shell-client.h"
wayland-scanner private-code "$protocol" "$work/xdg-shell.c"
aarch64-linux-gnu-gcc -Wall -Wextra -Werror -O2 -I"$work" \
    "$source_dir/adreno-probe.c" "$work/xdg-shell.c" \
    -lEGL -lGLESv2 -lwayland-client -lwayland-egl -lX11 -o "$work/adreno-probe"

install -m755 "$work/adreno-probe" "$hybris/adreno-probe"
install -m755 "$source_dir/warp-x11-egl" "$hybris/warp-x11-egl"
install -m644 "$source_dir/webgl.html" "$hybris/webgl.html"
install -m644 "$source_dir/10-mobile-terminal.json" "$hybris/10-mobile-terminal.json"
tar --sort=name --owner=0 --group=0 --numeric-owner -C "$hybris" -cf "$assets/hybris.tar" .
for source in deps/libhybris deps/android-headers; do
    for notice in "$source"/COPYING "$source"/LICENSE "$source"/LICENSE.*; do
        if [[ -f "$notice" ]]; then
            install -Dm644 "$notice" "$assets/licenses/${source##*/}/${notice##*/}"
        fi
    done
done
