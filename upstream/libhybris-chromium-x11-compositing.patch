+
+/* Chromium asks for the compositor's 32-bit ARGB visual when available.
+ * Match its selection of the lowest ID with the standard ARGB8888 masks. */
+static VisualID chromium_argb_visual(Display *dpy, int screen)
+{
+    char atom_name[32];
+    snprintf(atom_name, sizeof(atom_name), "_NET_WM_CM_S%d", screen);
+    Atom compositor = XInternAtom(dpy, atom_name, True);
+    if (compositor == None || XGetSelectionOwner(dpy, compositor) == None)
+        return None;
+
+    XVisualInfo criteria = {};
+    criteria.screen = screen;
+    criteria.depth = 32;
+    criteria.red_mask = 0xff0000;
+    criteria.green_mask = 0x00ff00;
+    criteria.blue_mask = 0x0000ff;
+    int count = 0;
+    XVisualInfo *infos = XGetVisualInfo(dpy,
+        VisualScreenMask | VisualDepthMask | VisualRedMaskMask | VisualGreenMaskMask | VisualBlueMaskMask,
+        &criteria, &count);
+    VisualID selected = None;
+    for (int i = 0; i < count; ++i) {
+        if (selected == None || infos[i].visualid < selected)
+            selected = infos[i].visualid;
+    }
+    if (infos) XFree(infos);
+    return selected;
 }
 
