 	uintptr_t  at_base;            /* AT_BASE — ld.so load addr; 0 for static */
 	uintptr_t  at_entry;           /* AT_ENTRY — binary's e_entry */
 
+	/* Virtual credentials presented to the ELF interpreter. */
