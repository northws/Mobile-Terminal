diff --git a/tawcroot/src/exec_handler.c b/tawcroot/src/exec_handler.c
--- a/tawcroot/src/exec_handler.c
+++ b/tawcroot/src/exec_handler.c
@@ -68,6 +68,26 @@
 	return 0;
 }
 
+
+/* Honor the Debian sudo executable's setuid mode in the guest view.
+ * Check the opened file's resolved path, so host binds and lookalikes
+ * elsewhere in the filesystem do not acquire a virtual root identity.
+ * Android's real IDs and no_new_privs are untouched. */
+static int probe_debian_sudo(int fd)
+{
+	if (tawcroot_rootfs_fd < 0 || tawcroot_rootfs_host_path_len == 0)
+		return 0;
+	static char path[4096]; /* caller holds exec_lock */
+	long len = tawcroot_proc_fd_to_host_path(fd, path, sizeof path);
+	if (len <= (long)tawcroot_rootfs_host_path_len ||
+	    !tawc_starts_with(path, tawcroot_rootfs_host_path) ||
+	    !tawc_streq(path + tawcroot_rootfs_host_path_len, "/usr/bin/sudo"))
+		return 0;
+	struct statx stx;
+	const unsigned int setuid_bit = 04000;
+	return tawc_statx(fd, "", AT_EMPTY_PATH, STATX_MODE, &stx) == 0 &&
+	       (stx.stx_mode & setuid_bit) != 0;
+}
 
 /* Require the file at `fd` to parse as an ET_EXEC/ET_DYN ELF for this
  * machine. A wrong-arch / malformed / too-short file is -ENOEXEC, which
@@ -321,6 +341,7 @@
 			                             argv_off) + 1;
 		r = classify_loadable((int)probe, 0, &sa);
 	}
+	int debian_sudo = r == 0 && sa.extra == 0 && probe_debian_sudo((int)probe);
 	tawc_close((int)probe);
 
 	/* cmdline_bytes: the NUL-joined argv the loader will install, which
@@ -357,6 +378,8 @@
 	 * and legacy --exec-via-handler modes. */
 	tawc_identity ident_snap;
 	tawcroot_identity_get(&ident_snap);
+	if (debian_sudo)
+		ident_snap.euid = ident_snap.suid = ident_snap.fsuid = 0;
 	extras.identity = &ident_snap;
 
 	if (tawcroot_rootfs_fd >= 0 && tawcroot_rootfs_host_path_len > 0) {
