+/* Chromium's ANGLE requests a GBM display without a device when Ozone
+ * cannot open a DRM render node. Provide an offscreen Android display for
+ * this explicit opt-in. Actual GBM devices require a GBM driver. */
+static EGLBoolean chromiumOffscreenEnabled(void)
+{
+	const char *enabled = getenv("MOBILE_TERMINAL_CHROMIUM_EGL");
+	return enabled && strcmp(enabled, "1") == 0;
+}
