+static EGLDisplay _my_eglGetPlatformDisplayEXT(EGLenum platform, void *display_id,
+		const EGLint *attrib_list)
+{
+	/* No platform attributes are currently consumed. The EXT ABI uses
+	 * EGLint attributes, while the EGL 1.5 ABI uses EGLAttrib. */
+	(void)attrib_list;
+	if (platform == EGL_NONE) {
+		__eglHybrisSetError(EGL_BAD_PARAMETER);
+		return EGL_NO_DISPLAY;
+	}
+	return __eglHybrisGetPlatformDisplayCommon(platform, display_id, NULL);
+}
