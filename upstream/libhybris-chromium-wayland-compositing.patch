+		const char *enabled = getenv("MOBILE_TERMINAL_CHROMIUM_WAYLAND_COMPOSITING");
+		if (enabled && strcmp(enabled, "1") == 0) {
+			platform = EGL_PLATFORM_WAYLAND_KHR;
+			display_id = NULL;
+		}
+	}
+#endif
